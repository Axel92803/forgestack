#!/usr/sbin/nft -f
# ForgeStack firewall ruleset
# Managed by Ansible — do not edit manually

flush ruleset

table inet firewall {

	# IPv4 only — no IPv6 on Internal Switch
	set ssh_limit {

		type ipv4_addr
		flags dynamic,timeout
		timeout 1m
	}

	chain input {

		type filter hook input priority 0; policy drop;

		ct state established,related accept

		iif "lo" accept

		ct state invalid drop

		# Rate-limited ICMP
		ip protocol icmp limit rate {{ icmp_rate_limit }} accept
		ip6 nexthdr icmpv6 limit rate {{ icmp_rate_limit }} accept

		# Allow SSH from trusted Ansible subnet (no rate limit)
		tcp dport {{ ssh_port }} ip saddr {{ ansible_subnet }} accept

		# Rate limit SSH from all other sources
		tcp dport {{ ssh_port }} ct state new \
			add @ssh_limit { ip saddr limit rate 3/minute burst 5 packets } \
			accept

		# Allow all traffic from admin host
		ip saddr {{ ansible_admin }} accept

		# Log and drop everything else
		log prefix " nftables-drop: " counter drop
	}

	chain forward {

		type filter hook forward priority 0; policy drop;
	}

	chain output {

		type filter hook output priority 0; policy accept;
	}

}
